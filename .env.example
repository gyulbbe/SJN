# Default: no configuration, login, or server required.
NEXT_PUBLIC_STORAGE_MODE=local
# Opt in with NEXT_PUBLIC_STORAGE_MODE=supabase after applying supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_. Never commit real keys.
SUPABASE_SECRET_KEY=
