# No configuration is needed for local work. Development scripts force local.
APP_ENV=local
STORAGE_MODE=auto
# Production: APP_ENV=production; STORAGE_MODE=auto (D1) (production failures block editing; local mode is for development only).
# D1 DB and R2 ASSET_BUCKET are Workers bindings in wrangler.jsonc, not URL/password variables.
BETTER_AUTH_URL=
# Server secrets only; configure deployed values with wrangler secret put.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional legacy Node/Next Supabase adapter; explicitly select STORAGE_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy NEXT_PUBLIC_STORAGE_MODE is accepted only when STORAGE_MODE is absent.

# Browser MoGe: optional HTTPS mirror of the exact pinned FP32 artifact.
# Default is the official Hugging Face revision URL; expected SHA-256 remains enforced.
# NEXT_PUBLIC_MOGE_MODEL_URL=https://your-dedicated-model-host/model.onnx
# Gemma uses server binding AI and sjn-gateway. Never expose an AI token through NEXT_PUBLIC_.
