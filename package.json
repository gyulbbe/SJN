    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
