{
  "name": "gongganmiri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:webgl": "node --experimental-strip-types tests/render-browser.ts",
    "test:images": "node --experimental-strip-types tests/image-browser.ts",
    "test:ui": "playwright test e2e/simple-editor.spec.ts e2e/room-fixtures.spec.ts",
    "test:failure": "node --experimental-strip-types tests/failure-browser.ts",
    "test:segmentation": "node --experimental-strip-types tests/segmentation-browser.ts",
    "format": "prettier --write src tests e2e",
    "test:comparison": "node --experimental-strip-types tests/comparison-render-browser.ts",
    "test:reconstruction": "node --experimental-strip-types tests/reconstruction-browser.ts",
    "test:reconstruction:quality": "node --experimental-strip-types tests/reconstruction-quality-browser.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --port 8787 --persist-to .wrangler/state",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "three": "0.185.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.0",
    "vinext": "1.0.0-beta.9",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react-server-dom-webpack": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "vite": "8.2.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "@cloudflare/vite-plugin": "1.54.4",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
