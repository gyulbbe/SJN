{
  "name": "gongganmiri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-local.mjs vinext",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:webgl": "node tests/run-browser-test.mjs tests/render-browser.ts",
    "test:images": "node tests/run-browser-test.mjs tests/image-browser.ts",
    "test:ui": "playwright test e2e/simple-editor.spec.ts e2e/room-fixtures.spec.ts",
    "test:failure": "node tests/run-browser-test.mjs tests/failure-browser.ts",
    "test:segmentation": "node tests/run-browser-test.mjs tests/segmentation-browser.ts",
    "format": "prettier --write src tests e2e",
    "test:comparison": "node tests/run-browser-test.mjs tests/comparison-render-browser.ts",
    "test:reconstruction": "node tests/run-browser-test.mjs tests/reconstruction-browser.ts",
    "test:reconstruction:quality": "node tests/run-browser-test.mjs tests/reconstruction-quality-browser.ts",
    "dev:vinext": "node scripts/dev-local.mjs vinext",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --port 8787 --persist-to .wrangler/state",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "test:cloudflare": "playwright test --config playwright.cloudflare.config.ts",
    "test:background-removal": "playwright test --config playwright.background-removal.config.ts",
    "test:reconstruction:standard": "node tests/run-browser-test.mjs tests/reconstruction-standard-browser.ts",
    "dev:next": "node scripts/dev-local.mjs next",
    "db:dev:migrate": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc --persist-to .wrangler/development"
  },
  "dependencies": {
    "@tensorflow/tfjs-backend-wasm": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "better-auth": "1.7.4",
    "idb": "^8.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "onnxruntime-web": "1.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "^0.35.4",
    "three": "0.185.1",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.0.0",
    "jose": "6.2.12",
    "miniflare": "5.20260911.0-alpha",
    "prettier": "3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.2.2",
    "vitest": "^3.2.0",
    "wrangler": "4.131.1"
  },
  "type": "module"
}
